---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowseClient from '../components/browse/BrowseClient.tsx';
import papers from '../../data/papers.normalized.json';
import type { Paper } from '~/utils/types';
import { isInCurrentMonth } from '~/utils/dates';

const typedPapers = papers as Paper[];
const totalPapers = typedPapers.length;
const totalCountries = Array.from(
  new Set(typedPapers.map((paper) => paper.country).filter(Boolean))
).length;
const countriesThisMonth = Array.from(
  new Set(
    typedPapers
      .filter((paper) => isInCurrentMonth(paper.date))
      .map((paper) => paper.country)
      .filter(Boolean)
  )
).length;
const latestPaperDate = typedPapers.reduce<Date | null>((latest, paper) => {
  if (!paper.date) return latest;

  const parsedDate = new Date(paper.date);
  if (Number.isNaN(parsedDate.getTime())) return latest;

  if (!latest || parsedDate > latest) {
    return parsedDate;
  }

  return latest;
}, null);
const lastUpdatedLabel = latestPaperDate
  ? latestPaperDate.toLocaleString('en-US', { month: 'long', year: 'numeric' })
  : 'Unknown';

const highlightCards = [
  {
    title: 'Instant refinement',
    body: 'Use search and filters together to hone in on methods, populations, or outcomes without losing context.'
  },
  {
    title: 'Shareable states',
    body: 'Copy links with every facet preserved so collaborators can reproduce your exact view.'
  },
  {
    title: 'Signal-rich summaries',
    body: 'Domain, geography, and design details stay visible to anchor each finding inside the evidence base.'
  }
];
---

<BaseLayout
  title="Browse papers"
  description="Searchable repository of OHCA survivorship literature"
  heroTheme="survivorship-grid"
>
  <Fragment slot="hero">
    <div class="page-hero space-y-6">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-slate-900/35 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-teal-100 backdrop-blur-sm"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-300 animate-pulse"></span>
        Dynamic filtering workspace
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Browse the evidence base
        <span
          class="mt-2 block text-transparent bg-clip-text bg-gradient-to-r from-cyan-100 via-sky-100 to-teal-200"
        >
          Search, filter, and share
        </span>
      </h1>
      <p class="mx-auto max-w-3xl text-lg font-light text-slate-200 md:text-xl">
        Filter by author, title, institution, country, and more. Abstracts and source links stay
        visible so you can keep the signal of each study in view while navigating the evidence
        trail.
      </p>
    </div>
  </Fragment>

  <section class="-mt-12 -mx-6 px-6 pb-10 lg:-mx-8 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div
        class="overflow-hidden rounded-[2rem] border border-white/65 bg-white/88 shadow-[0_28px_80px_rgba(15,23,42,0.14)] ring-1 ring-slate-200/70 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/90 dark:ring-slate-800"
      >
        <div
          class="flex flex-col gap-4 border-b border-slate-200/70 px-6 pb-4 pt-6 md:flex-row md:items-center md:justify-between dark:border-slate-800"
        >
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400"
            >
              Evidence snapshot
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-300">Updated {lastUpdatedLabel}</p>
          </div>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-teal-200/80 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-700 dark:border-teal-500/40 dark:bg-teal-950/30 dark:text-teal-200"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Live feed
          </span>
        </div>
        <div class="grid gap-0 px-6 pb-3 md:grid-cols-3">
          <div
            class="px-4 py-5 text-center md:border-r md:border-slate-200/70 dark:md:border-slate-800"
          >
            <div class="text-3xl font-bold text-slate-900 dark:text-white">
              {totalPapers.toLocaleString()}
            </div>
            <div
              class="mt-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-300"
            >
              Papers
            </div>
          </div>
          <div
            class="px-4 py-5 text-center md:border-r md:border-slate-200/70 dark:md:border-slate-800"
          >
            <div class="text-3xl font-bold text-slate-900 dark:text-white">
              {totalCountries.toLocaleString()}
            </div>
            <div
              class="mt-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-300"
            >
              Countries
            </div>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">
              This month: {countriesThisMonth.toLocaleString()}
            </p>
          </div>
          <div class="px-4 py-5 text-center">
            <div class="text-xl font-semibold text-slate-900 dark:text-white">
              {lastUpdatedLabel}
            </div>
            <div
              class="mt-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-300"
            >
              Last update
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="-mx-6 px-6 pb-14 lg:-mx-8 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-10">
      <div
        class="grid overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/80 shadow-[0_18px_50px_rgba(15,23,42,0.08)] ring-1 ring-slate-100/80 backdrop-blur md:grid-cols-3 dark:border-slate-800 dark:bg-slate-900/75 dark:ring-slate-800"
      >
        {
          highlightCards.map((card) => (
            <div class="border-b border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-teal-50/70 p-6 last:border-b-0 md:border-b-0 md:border-r dark:border-slate-800 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950/20">
              <p class="text-sm font-semibold uppercase tracking-[0.22em] text-teal-700 dark:text-teal-200">
                {card.title}
              </p>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-200/90">{card.body}</p>
            </div>
          ))
        }
      </div>

      <div
        id="papers"
        class="rounded-[2rem] border border-slate-200/80 bg-white/92 p-5 shadow-[0_24px_70px_rgba(15,23,42,0.12)] ring-1 ring-slate-100/80 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/85 dark:ring-slate-800 sm:p-6"
      >
        <BrowseClient client:load papers={typedPapers} />
      </div>
    </div>
  </section>
</BaseLayout>
