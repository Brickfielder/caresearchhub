---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowseClient from '../components/browse/BrowseClient.tsx';
import papers from '../../data/papers.normalized.json';
import type { Paper } from '~/utils/types';

const typedPapers = papers as Paper[];
---

<BaseLayout
  title="Search papers"
  description="Searchable repository of cardiac arrest survivorship literature"
>
  <section class="browse-hero">
    <div>
      <h1>Browse the evidence base</h1>
      <p>Search, filter, and share</p>
    </div>
  </section>

  <section id="papers" class="browse-page-workspace">
    <BrowseClient client:load papers={typedPapers} />
  </section>
</BaseLayout>
