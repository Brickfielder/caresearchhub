---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearchClient from '../components/HomeSearchClient.tsx';
import papers from '../../data/papers.normalized.json';
import { getPaperUrl } from '~/utils/format';
import { getBrowseUrl } from '~/utils/siteUrls';
import type { Paper } from '~/utils/types';

const typedPapers = papers as Paper[];
const browseUrl = new URL(getBrowseUrl());
const browseHref = browseUrl.pathname.endsWith('/') ? browseUrl.pathname : `${browseUrl.pathname}/`;
const buildBrowseHref = ({ query, quick }: { query?: string; quick?: string } = {}) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (quick) params.set('quick', quick);
  return `${browseHref}${params.size ? `?${params}` : ''}#papers`;
};

const domainCards = [
  { title: 'Cognitive', icon: '🧠' },
  { title: 'Psychological', icon: '❤️' },
  { title: 'QoL', icon: '🌱' },
  { title: 'Participation/RTW', icon: '💼' },
  { title: 'Caregiver', icon: '👪' }
];

const publicationTimestamp = (paper: Paper) =>
  new Date(paper.date ?? `${paper.year}-01-01`).getTime();
const recentPapers = [...typedPapers]
  .sort((a, b) => publicationTimestamp(b) - publicationTimestamp(a))
  .slice(0, 3);

const primarySource = (paper: Paper) => paper.links.pubmed ?? paper.links.doi ?? paper.links.pmc;
---

<BaseLayout
  title="Cardiac Arrest Research Hub"
  description="Evidence summaries for life after cardiac arrest"
>
  <section class="home-hero">
    <h1>Cardiac Arrest Survivorship<br />Research Hub</h1>
    <h2>Our Mission</h2>
    <p>
      To strengthen cardiac arrest survivorship research by connecting researchers, reducing
      duplication, and accelerating progress in aftercare science.
    </p>
    <p>
      Mapping the evidence that tells us what life looks like after survival, with a focus on
      cognitive, psychological, social, and quality-of-life outcomes.
    </p>
    <HomeSearchClient client:load papers={typedPapers} browseResultsHref={buildBrowseHref()} />
  </section>

  <section class="home-domains" aria-labelledby="domains-heading">
    <h2 id="domains-heading" class="sr-only">Browse by research domain</h2>
    <div class="domain-grid">
      {
        domainCards.map((domain) => (
          <a href={buildBrowseHref({ quick: domain.title })}>
            <span class="domain-icon" aria-hidden="true">
              {domain.icon}
            </span>
            <strong>{domain.title}</strong>
            <span>Browse related evidence →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-publications" aria-labelledby="recent-publications-heading">
    <div class="home-publications-head">
      <div>
        <p>New to the repository</p>
        <h2 id="recent-publications-heading">Recent publications</h2>
      </div>
      <a href={buildBrowseHref()}>Browse all evidence →</a>
    </div>

    <div class="publication-cards">
      {
        recentPapers.map((paper) => (
          <article class="publication-card">
            <div class="publication-card-meta">
              <span>{paper.domains?.[0] ?? 'Evidence'}</span>
              <p>
                {paper.journal} · {paper.year}
              </p>
            </div>
            <h3>
              <a href={getPaperUrl(paper)}>{paper.title}</a>
            </h3>
            <p class="publication-authors">{paper.normalizedAuthors.join(', ')}</p>
            <details>
              <summary>
                <span>Read abstract</span>
                <span>Hide abstract</span>
              </summary>
              <p>{paper.abstract || 'Abstract unavailable in the repository.'}</p>
            </details>
            <div class="publication-links">
              <a href={getPaperUrl(paper)}>View paper</a>
              {primarySource(paper) && (
                <a href={primarySource(paper)} target="_blank" rel="noreferrer">
                  Source ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
