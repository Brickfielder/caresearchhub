---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CollaboratorMap from '~/components/collaborate/CollaboratorMap';
import CollaboratorDirectory from '~/components/collaborate/CollaboratorDirectory';
import collaboratorData from '../../data/resuscitation-network-people.json';
import type { Collaborator } from '~/utils/types';
import { Fragment } from 'preact';

const { people = [], meta } = collaboratorData as {
  people: Collaborator[];
  meta: { updated_at?: string };
};
const hasPeople = people.length > 0;
const totalCountries = new Set(people.map((person) => person.country)).size;
const highlightedTags = [
  'cognition',
  'psychological-support',
  'quality-of-life',
  'return-to-work',
  'family'
];

const filters = [
  { label: 'Cognition', slug: 'cognition' },
  { label: 'Psychological support', slug: 'psychological-support' },
  { label: 'Quality of life', slug: 'quality-of-life' },
  { label: 'Return to work', slug: 'return-to-work' },
  { label: 'Family & co-survivors', slug: 'family' },
  { label: 'Registry analyses', slug: 'registry' }
];

const qaItems = [
  {
    question: 'Why was the map of survivorship created?',
    answer:
      'To connect researchers working on life after OHCA. Visibility reduces duplication, speeds collaboration, and supports intervention and service development.'
  },
  {
    question: 'What does the map show?',
    answer:
      'Pins for people active in survivorship research. Each pin links to a profile covering role, institution, country/region, and a short summary.'
  },
  {
    question: 'What is the content and sources on which the map is based?',
    answer:
      'Self-submitted entries reviewed by editors; each entry notes the source and last update.'
  },
  {
    question: 'How can I make an entry on the map myself?',
    answer:
      'Use the “Add your entry” button to send details or submit. The editors check scope and consent, then publish the update.'
  }
];
const networkStats = [
  { label: 'Collaborators', value: people.length.toLocaleString() },
  { label: 'Countries', value: totalCountries.toLocaleString() },
  { label: 'Last update', value: meta?.updated_at ?? '—' }
];
---

<BaseLayout
  title="Collaborate on survivorship science"
  description="Map, directory, and Q&A for the survivorship & co-survivorship network"
  heroTheme="survivorship-grid"
>
  <Fragment slot="hero">
    <div class="page-hero space-y-6">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-slate-900/35 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-teal-100 backdrop-blur-sm"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-300 animate-pulse"></span>
        Collaborator hub
      </p>
      <h1 class="text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">
        <span class="block">Connecting the people researching life</span>
        <span
          class="mt-2 block text-transparent bg-clip-text bg-gradient-to-r from-cyan-100 via-sky-100 to-teal-200"
        >
          after cardiac arrest
        </span>
      </h1>
      <p class="mx-auto max-w-3xl text-base text-slate-200 sm:text-lg sm:leading-relaxed">
        Discover researchers, clinicians, survivors, and co-survivors. Find collaborators, share
        ideas, and accelerate survivorship science and services across borders.
      </p>
    </div>
  </Fragment>

  <section class="-mt-12 -mx-4 px-4 pb-10 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div
        class="overflow-hidden rounded-[2rem] border border-white/65 bg-white/88 shadow-[0_28px_80px_rgba(15,23,42,0.14)] ring-1 ring-slate-200/70 backdrop-blur-xl"
      >
        <div
          class="flex flex-col gap-4 border-b border-slate-200/70 px-6 pb-4 pt-6 md:flex-row md:items-center md:justify-between"
        >
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">
              Network snapshot
            </p>
            <p class="text-sm text-slate-500">Updated {meta?.updated_at ?? '—'}</p>
          </div>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-teal-200/80 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-700"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Live feed
          </span>
        </div>
        <div class="grid gap-0 px-6 pb-3 md:grid-cols-3">
          {
            networkStats.map((stat) => (
              <div
                class="px-4 py-5 text-center md:border-r md:border-slate-200/70 last:md:border-r-0"
                key={stat.label}
              >
                <div class="text-3xl font-bold text-slate-900">{stat.value}</div>
                <div class="mt-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-10 px-4 pb-12 pt-0 sm:px-6 lg:px-8">
    {
      hasPeople ? (
        <Fragment>
          <section
            id="map"
            class="space-y-6 rounded-[2rem] border border-slate-200/80 bg-white/92 p-8 shadow-[0_24px_70px_rgba(15,23,42,0.1)] ring-1 ring-slate-100/80 backdrop-blur-xl"
          >
            <header class="space-y-3">
              <p class="text-sm font-semibold uppercase tracking-[0.32em] text-teal-700">
                Global map
              </p>
              <h2 class="text-3xl font-semibold text-slate-900">
                Where survivorship and co-survivorship work is happening
              </h2>
              <p class="text-base text-slate-600">
                Explore who is working on survivorship around the world. Filter by specialty or use
                the directory to focus on names, organisations, job roles, and countries.
              </p>
            </header>
            <div class="flex flex-wrap gap-3">
              {filters.map((filter) => (
                <span
                  key={filter.slug}
                  class={`rounded-full border px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] ${highlightedTags.includes(filter.slug) ? 'border-teal-200 bg-teal-50 text-teal-700' : 'border-slate-200 bg-white/80 text-slate-500'}`}
                >
                  {filter.label}
                </span>
              ))}
            </div>
            <CollaboratorMap client:only="preact" people={people} />
          </section>

          <section
            id="directory"
            class="space-y-6 rounded-[2rem] border border-slate-200/80 bg-white/92 p-8 shadow-[0_24px_70px_rgba(15,23,42,0.1)] ring-1 ring-slate-100/80 backdrop-blur-xl"
          >
            <header class="space-y-3">
              <p class="text-sm font-semibold uppercase tracking-[0.32em] text-teal-700">
                Directory
              </p>
              <h2 class="text-3xl font-semibold text-slate-900">Researchers & collaborators</h2>
              <div class="space-y-3 text-base text-slate-600">
                <p>
                  This growing network brings together researchers, clinicians, and survivor-led
                  groups who are advancing long-term survivorship after cardiac arrest. Each card
                  highlights two things:
                </p>
                <ul class="list-disc space-y-2 pl-6">
                  <li>
                    <strong>"What I can offer"</strong> – specific resources, datasets, expertise,
                    or services others may find useful.
                  </li>
                  <li>
                    <strong>"Looking to collaborate on"</strong> – areas where you’d welcome
                    partners, data sharing, co-design, or methodological support.
                  </li>
                </ul>
                <p>
                  These short entries help people spot synergy quickly and build collaborations that
                  would be hard to find otherwise.
                </p>
                <details class="rounded-2xl border border-slate-200 bg-slate-50/85 p-4 text-sm">
                  <summary class="cursor-pointer text-base font-semibold text-slate-800">
                    Examples of “What I can offer”
                  </summary>
                  <ul class="mt-3 list-disc space-y-1 pl-6">
                    <li>Follow-up registry with 6–12 month outcomes</li>
                    <li>Post-arrest rehabilitation pathway (MoCA, EQ-5D, HADS)</li>
                    <li>Access to survivor peer networks for co-design</li>
                    <li>Qualitative methods expertise; experience running sub-studies</li>
                    <li>AI tools for semi-automated literature screening</li>
                  </ul>
                </details>
                <details class="rounded-2xl border border-slate-200 bg-slate-50/85 p-4 text-sm">
                  <summary class="cursor-pointer text-base font-semibold text-slate-800">
                    Examples of “Looking to collaborate on”
                  </summary>
                  <ul class="mt-3 list-disc space-y-1 pl-6">
                    <li>Harmonising PRO measures across sites</li>
                    <li>Multinational follow-up datasets</li>
                    <li>Co-designing support pathways for survivors and relatives</li>
                    <li>Linking acute and long-term datasets</li>
                    <li>Developing digital resources for survivorship</li>
                  </ul>
                </details>
              </div>
              <p class="text-base text-slate-600">
                Search by name, organisation, tags, or country.
              </p>
            </header>
            <CollaboratorDirectory client:load people={people} />
          </section>
        </Fragment>
      ) : (
        <section class="space-y-4 rounded-[2rem] border border-slate-200/80 bg-white/92 p-8 text-slate-800 shadow-[0_24px_70px_rgba(15,23,42,0.1)] ring-1 ring-slate-100/80 backdrop-blur-xl">
          <p class="text-sm font-semibold uppercase tracking-[0.32em] text-amber-600">
            Directory paused
          </p>
          <h2 class="text-3xl font-semibold text-slate-900">
            No collaborators are currently listed
          </h2>
          <p class="text-base text-slate-700">
            We have temporarily removed all collaborator entries until each person confirms consent
            to be shown here. If you previously shared your details and would like them restored, or
            if you want to add a new consented entry, please email
            <a class="font-semibold text-teal-700 underline" href="hello@caresearchhub.org">
              hello@caresearchhub.org
            </a>
            .
          </p>
        </section>
      )
    }

    <section
      class="rounded-[2rem] border border-teal-200/80 bg-gradient-to-r from-teal-50 via-cyan-50 to-white p-8 text-slate-900 shadow-[0_18px_50px_rgba(13,148,136,0.12)]"
    >
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.32em] text-teal-700">
            Call for entries
          </p>
          <h3 class="mt-3 text-2xl font-semibold">Are you active in survivorship research?</h3>
          <p class="mt-2 text-base text-slate-600">
            If you cannot find yourself on the map, email your name, role, organisation, city &
            country, tags or keywords, a short summary of your work, plus two lines for “What I can
            offer” and “Looking to collaborate on.” We will review the scope and publish your entry.
          </p>
        </div>
        <a
          class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-slate-800"
          href="mailto:hello@caresearchhub.org?subject=Add%20me%20to%20the%20OHCA%20survivorship%20map"
        >
          Add yourself to the map
        </a>
      </div>
    </section>

    <section
      id="qa"
      class="space-y-6 rounded-[2rem] border border-slate-200/80 bg-white/92 p-8 shadow-[0_24px_70px_rgba(15,23,42,0.1)] ring-1 ring-slate-100/80 backdrop-blur-xl"
    >
      <header class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-teal-700">
          Questions & answers
        </p>
        <h2 class="text-3xl font-semibold text-slate-900">Map scope and stewardship</h2>
        <p class="text-base text-slate-600">
          This list does not claim to be complete, nor can accuracy or topicality be guaranteed.
        </p>
      </header>
      <div class="space-y-4">
        {
          qaItems.map((item) => (
            <details
              key={item.question}
              class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4 text-slate-700"
            >
              <summary class="cursor-pointer text-base font-semibold text-slate-900">
                {item.question}
              </summary>
              <p class="mt-2 text-sm text-slate-600">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section
      class="rounded-[2rem] border border-teal-200/80 bg-teal-50/80 p-8 text-slate-900 shadow-[0_18px_50px_rgba(13,148,136,0.1)]"
    >
      <div class="space-y-4">
        <h2 class="text-2xl font-semibold">Data and stewardship</h2>
        <p class="text-base text-slate-600">
          Data notice: entries are published with consent; removal or edit requests are honoured.
          Contact <a class="text-teal-700 underline" href="mailto:hello@caresearchhub.org"
            >hello@caresearchhub.org</a
          >.
        </p>
      </div>
    </section>
  </section>
</BaseLayout>
